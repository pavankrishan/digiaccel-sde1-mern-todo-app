# MongoDB connection string (e.g. MongoDB Atlas).
# If omitted in development, an in-memory MongoDB is started automatically.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/todo?retryWrites=true&w=majority

PORT=5050

# Comma-separated list of allowed frontend origins. Leave empty to allow all (dev only).
CORS_ORIGIN=http://localhost:5173
